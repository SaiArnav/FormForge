datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SHORT_ANSWER
  PARAGRAPH
  EMAIL
  PHONE
  NUMBER
  DATE
  TIME
  DROPDOWN
  MULTIPLE_CHOICE
  CHECKBOXES
  RATING
  FILE_UPLOAD
  IMAGE_UPLOAD
  GRID
}

enum GridKind {
  ROW
  COLUMN
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?
  forms        Form[]
}

model Form {
  id                 String     @id @default(cuid())
  title              String
  description        String?
  status             FormStatus @default(DRAFT)
  acceptingResponses Boolean    @default(true)
  createdBy          String
  admin              AdminUser  @relation(fields: [createdBy], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  questions          Question[]
  responses          Response[]
}

model Question {
  id          String           @id @default(cuid())
  formId      String
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  type        QuestionType
  title       String
  description String?
  required    Boolean          @default(false)
  order       Int
  validation  String?
  options     QuestionOption[]
  answers     ResponseAnswer[]
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  order      Int      @default(0)
  kind       GridKind @default(ROW)
}

model Response {
  id          String           @id @default(cuid())
  formId      String
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedAt DateTime         @default(now())
  metadata    String?
  answers     ResponseAnswer[]
  files       UploadedFile[]
}

model ResponseAnswer {
  id         String   @id @default(cuid())
  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
}

model UploadedFile {
  id         String   @id @default(cuid())
  responseId String?
  response   Response? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  sessionId  String?
  url        String
  filename   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

model Settings {
  id            String @id @default("default")
  configuration String @default("{}")
}
